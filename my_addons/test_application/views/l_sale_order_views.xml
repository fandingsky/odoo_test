<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="l_sale_order_form_view" model="ir.ui.view">
        <field name="name">l.sale.order.form.view</field>
        <field name="model">l.sale.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="go_back" string="返回上一页" type="object"/>
                    <button name="state_to_draft" string="起草中" type="object"/>
                    <button name="state_to_confirm" string="确认" type="object"/>
                    <button name="state_to_done" string="完成" type="object"/>
                    <button name="delete_order" string="删除" type="object" confirm="确定要删除该订单吗"/>
                    <field name="state" widget="statusbar"/>
<!--                    statubar默认在flex布局的最右边-->
                    <button name="action_view_order_lines"
                        string="订单行" icon="fa-list" type="object">
                    <field name="line_count" widget="statinfo" string="行数"/>
                    </button>
                </header>
                <sheet>
                        <h1>
                            <field name="name"/>
                        </h1>
                    <group>
                        <group>
<!--                            partner_id 也是一个 Many2one，可以加上 options 阻止在订单界面直接创建客户-->
<!--                            options="{'no_create': True, 'no_open': True}-->
                            <field name="partner_id" widget="res_partner_many2one" options="{'no_create': True, 'no_open': True}"/>
                            <field name="state"/>
                            <field name="barcode"/>
                        </group>
                        <group>
                            <field name="validate_date"/>
                            <field name="payment_type"/>
                        </group>
                    </group>

                    <group>
                        <field name="note" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="明细行">
                            <field name="line_ids">
<!--                                使提交表单在当前notebook之中而不是新开一个form表单-->
<!--                                如果是bottom那么每次都添加在最底下，如果是top那就是每次添加在最顶上-->
<!--                                create="False"那么就不可创建，反之可以，delete同理-->
<!--                                default_order="qty"即为默认排序-->
<!--                                <list editable="bottom" create="true" delete="true" default_order="qty">-->
                                <list editable="bottom" create="true" delete="true">
                                    <!--                                    添加手柄排序-->
                                    <field name="sequence" widget="handle"/>

                                    <field name="name" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tax_tags"/>
                                    <field name="amount_total"/>
<!--                                    <button name="button_add" type="object" string="增加many2many"/>-->
<!--                                    <button name="button_link" type="object" string="增加已有的字段many2many"/>-->
<!--                                    <button name="button_update" type="object" string="更新已有的many2many"/>-->
                                    <button name="button_updateall" type="object" string="更新所有已有的many2many"/>
<!--                                    <button name="button_delete" type="object" string="删除数据库已有的many2many"/>-->
<!--                                    <button name="button_unlink" type="object" string="删除与这个表关联的many2many"/>-->
<!--                                    <button name="button_unlinkall" type="object" string="删除与这个表关联的many2many"/>-->

                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="product_id"/>
                                        </group>
                                        <group>
                                            <field name="qty"/>
                                            <field name="price_unit"/>
                                            <field name="amount_total"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="other">
                                <group>
                                    <field name="note"/>
                                </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="l_sale_order_list_view" model="ir.ui.view">
        <field name="name">l.sale.order.list.view</field>
        <field name="model">l.sale.order</field>
        <field name="arch" type="xml">
            <list>
<!--                decoration-info是装饰属性-->
                <field name="name"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirm'"
                       decoration-muted="state == 'done'"/>
                <field name="partner_id"/>
                <field name="validate_date"/>
                <field name="payment_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="l_sale_order_search_view" model="ir.ui.view">
        <field name="name">l.sale.order.search.view</field>
        <field name="model">l.sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="订单号"
                       filter_domain="[('name','ilike',self)]"/>
                <field name="partner_id" string="客户"/>
                <field name="validate_date" string="有效期"/>
                <field name="payment_type" string="付款方式"/>
                <field name="state" string="状态"/>
                <separator/>
                <filter string="草稿" name="draft" domain="[('state','like','draft')]"/>
                <filter string="已确认" name="confirm" domain="[('state','like','confirm')]"/>
                <filter string="已完成" name="done" domain="[('state','like','done')]"/>
            </search>
        </field>
    </record>


    <record id="l_sale_order_line_act_window" model="ir.actions.act_window">
        <field name="name">订单行</field>
        <field name="res_model">l.sale.order.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="l_sale_order_act_window" model="ir.actions.act_window">
        <field name="name">我的测试单据</field>
        <field name="res_model">l.sale.order</field>
        <field name="view_mode">list,form</field>
<!--        这里是加载页面的时候默认搜索栏筛选出草稿阶段的-->
        <field name="context">{}</field>
    </record>

    <record id="l_sale_order_line_list_view" model="ir.ui.view">
        <field name="name">l.sale.order.line.list</field>
        <field name="model">l.sale.order.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="qty"/>
                <field name="price_unit"/>
                <field name="amount_total"/>
            </list>

        </field>
    </record>

    <record id="l_odoo_url_action" model="ir.actions.act_url">
        <field name="name">odoo网址</field>
        <field name="url">https://www.odoo.com</field>
        <field name="target">new</field>
    </record>


</odoo>