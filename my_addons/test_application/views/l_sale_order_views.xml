<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="l_sale_order_form_view" model="ir.ui.view">
        <field name="name">l.sale.order.form.view</field>
        <field name="model">l.sale.order</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="note" style="height: 100px;"/>
<!--                        html会将文本中的html标签渲染出来，显示为html格式，而不是文本格式。-->
<!--                               widget='html'-->

                        <field name="sequence"/>
                        <field name="qty"/>
                        <field name="is_bool"/>                                                                           ame="is_bool"/>
                        <field name="state"/>                                                                           ame="is_bool"/>
                        <field name="date_01"/>                                                                           ame="is_bool"/>
                        <field name="date_02"/>                                                                           ame="is_bool"/>
                        <field name="create_uid"/>
                        <field name="create_date"/>
                        <field name="write_uid"/>
                        <field name="write_date"/>
                    </group>
                    <group>
                        <group>
                            <field name="image"/>
                        </group>
                        <group>
                            <field name="binary"/>
                        </group>
                    </group>


                </sheet>
            </form>
        </field>
    </record>


    <record id="l_sale_order_list_view" model="ir.ui.view">
        <field name="name">l.sale.order.list.view</field>
        <field name="model">l.sale.order</field>
        <field name="arch" type="xml">
            <list>
<!--                这里是sequence的排序功能-->
                <field name="sequence"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="l_sale_order_act_window" model="ir.actions.act_window">
        <field name="name">我的测试单据</field>
        <field name="res_model">l.sale.order</field>
        <field name="view_mode">list,form</field>
    </record>




</odoo>