<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="l_sale_order_wizard_form_view" model="ir.ui.view">
        <field name="name">l.sale.order.wizard.form.view</field>
        <field name="model">l.sale.order.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <field name="order_id" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_confirm" string="确认" type="object" class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>